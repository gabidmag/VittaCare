# ============================================================
# VittaCare — .gitignore
# ============================================================

# ---------- Segredos e variáveis de ambiente ----------
# O modelo (.env.example) continua versionado.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/
application-local.yml
application-local.properties

# ---------- Java / Spring Boot ----------
# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
# Compilados e pacotes
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------- Node / React ----------
node_modules/
dist/
.vite/
.cache/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Os arquivos de lock (package-lock.json, yarn.lock, pnpm-lock.yaml)
# DEVEM ser versionados.

# ---------- Testes e cobertura ----------
coverage/
.nyc_output/
jacoco/
playwright-report/
test-results/
blo
