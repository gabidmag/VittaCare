# ============================================================
# VittaCare — .env.example
# Copie para .env (cp .env.example .env) e ajuste os valores.
# NUNCA versione o .env: ele está no .gitignore.
# Os valores abaixo são apenas para DESENVOLVIMENTO LOCAL.
# Em staging e produção, use o gerenciador de segredos da AWS.
# ============================================================

# ---------- Aplicação (back-end Spring Boot) ----------
# dev | staging | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Origem permitida no CORS (URL do front-end)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Banco de dados (PostgreSQL) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vittacare
POSTGRES_USER=vittacare
POSTGRES_PASSWORD=troque-esta-senha
# Montado a partir das variáveis acima (usado pela API)
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
# Em Docker Compose, o host do banco é o nome do serviço (ex.: POSTGRES_HOST=db)

# ---------- Segurança (JWT) ----------
# Chave de assinatura: mínimo de 32 caracteres, aleatória e exclusiva de cada ambiente.
# Gerar uma: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# Validade do token de acesso, em minutos
JWT_EXPIRATION_MINUTES=60
# Validade do token de redefinição de senha (RF002), em minutos
PASSWORD_RESET_TOKEN_MINUTES=30

# ---------- Dados de teste (somente dev) ----------
# Senha usada pelo seed de desenvolvimento (S1-03). Dados fictícios.
# Não usar em staging nem produção.
SEED_DEV_PASSWORD=troque-senha-de-teste

# ---------- Notificações (provedor externo de e-mail/SMS) ----------
# Provedor a definir; os nomes abaixo são genéricos.
NOTIFICACAO_PROVIDER_URL=https://api.provedor.example/v1
NOTIFICACAO_PROVIDER_API_KEY=troque-pela-chave-do-provedor
NOTIFICACAO_REMETENTE=nao-responda@vittacare.example

# ---------- Front-end (React) ----------
# URL base da API. O prefixo da variável depende da ferramenta de build
# escolhida na S1-01 (ex.: VITE_ para Vite, REACT_APP_ para Create React App).
VITE_API_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000
